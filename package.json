{
  "name": "wizard-vale-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/fetch-library.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:live": "astro build && wrangler pages dev dist --port 8788 --compatibility-date=2026-08-01",
    "presence:dev": "wrangler dev -c presence/wrangler.toml --port 8787 --ip 0.0.0.0",
    "presence:deploy": "wrangler deploy -c presence/wrangler.toml",
    "presence:check": "tsc --noEmit -p presence/tsconfig.json",
    "preview:mp": "astro build && wrangler pages dev dist --port 8788 --ip 0.0.0.0 --compatibility-date=2026-08-01"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@phosphor-icons/core": "^2.1.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^5.7.0",
    "maath": "^0.10.8",
    "mermaid": "^11.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "marked": "^18.0.10",
    "typescript": "^5.7.0",
    "wrangler": "^4.126.0"
  }
}
