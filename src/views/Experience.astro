---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { t, type Lang } from "../i18n/ui";
import { experienceNpcs } from "../data/experienceNpcs";
import { techCategories, techMonogram } from "../data/techSkills";
import fs from "node:fs";
import nodePath from "node:path";

/**
 * The logos, read off disk at build time and written straight into the page.
 * As <img> tags they were twenty-six separate requests inside a CSS-animated
 * strip, and with loading="lazy" a transformed container kept them from ever
 * being considered on screen: on a phone most of them simply never arrived.
 */
const logoDir = nodePath.join(process.cwd(), "public", "tech");
const logos = new Map<string, string>();
for (const cat of techCategories) {
  for (const item of cat.items) {
    if (!item.icon || logos.has(item.icon)) continue;
    const file = nodePath.join(logoDir, `${item.icon}.svg`);
    if (fs.existsSync(file)) logos.set(item.icon, fs.readFileSync(file, "utf8"));
  }
}
import { localizeYears } from "../islands/vale/boardSubject";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const dict = t(lang);
---

<Base
  lang={lang}
  path={path}
  title={`${dict.experience.title} · ${dict.site.name}`}
  description={dict.experience.sub}
>
  <Nav lang={lang} path={path} />
  <main class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold text-accent">{dict.world.places.experience}</p>
    <h1 class="mt-2 text-4xl font-black tracking-tighter sm:text-5xl">
      {dict.experience.title}
    </h1>
    <p class="mt-4 max-w-[58ch] text-muted">{dict.experience.sub}</p>
  </main>

  {/* Every technology, drifting slowly left. Full-bleed, so it reads as a
      band of the page rather than a box inside it. */}
  <div class="tech-marquee mt-4" aria-label={dict.experience.arsenalLabel}>
    <div class="tech-marquee-track">
      {
        [0, 1].map((copy) => (
          <div class="tech-marquee-group" aria-hidden={copy === 1}>
            {techCategories.map((cat) => (
              <Fragment>
                <span class="tech-cat">{cat.label[lang]}</span>
                {cat.items.map((item) => (
                  <span class="tech-tile">
                    {item.icon && logos.has(item.icon) ? (
                      <span class="tech-logo" set:html={logos.get(item.icon)} />
                    ) : (
                      <span class="tech-mono" aria-hidden="true">
                        {techMonogram(item.name)}
                      </span>
                    )}
                    <span>{item.name}</span>
                  </span>
                ))}
              </Fragment>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <main class="mx-auto max-w-4xl px-4 pb-16 sm:px-6">
    <div class="mt-12 space-y-6">
      {
        experienceNpcs.map((npc) => (
          <article class="rounded-xl border border-line bg-surface p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">
              {npc.name[lang]} · {localizeYears(npc.years, lang)}
            </p>
            <h2 class="mt-1 text-xl font-bold">{npc.role[lang]}</h2>
            <p class="mt-2 max-w-[62ch] text-sm leading-relaxed text-muted">
              {npc.tagline[lang]}
            </p>
            <ul class="mt-5 space-y-2.5">
              {npc.deeds.map((deed) => (
                <li class="flex gap-2.5 text-sm leading-relaxed">
                  <span aria-hidden class="mt-[0.1rem] shrink-0 text-accent">
                    &bull;
                  </span>
                  <span>{deed[lang]}</span>
                </li>
              ))}
            </ul>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {npc.tech.map((tag) => (
                <span class="rounded-full border border-line px-2.5 py-1 text-xs text-muted">
                  {tag}
                </span>
              ))}
            </div>
            <a
              href={npc.link.url}
              rel="noopener"
              target="_blank"
              class="mt-6 inline-flex items-center rounded-full bg-accent-fill px-4 py-2 text-sm font-bold text-accent-fill-ink hover:opacity-90"
            >
              {npc.link.label[lang]}
            </a>
          </article>
        ))
      }
    </div>
  </main>
  <Footer lang={lang} />
</Base>
