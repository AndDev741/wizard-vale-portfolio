---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { t, type Lang } from "../i18n/ui";
import { quests } from "../data/quests";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const dict = t(lang);
---

<Base
  lang={lang}
  path={path}
  title={`${dict.experience.title} · ${dict.site.name}`}
  description={dict.experience.sub}
>
  <Nav lang={lang} path={path} />
  <main class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold text-accent">{dict.world.places.experience}</p>
    <h1 class="mt-2 text-4xl font-black tracking-tighter sm:text-5xl">
      {dict.experience.title}
    </h1>
    <p class="mt-4 max-w-[58ch] text-muted">{dict.experience.sub}</p>
    <p class="mt-2 text-sm font-semibold">{dict.experience.role}</p>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        quests.map((q, i) => (
          <article
            class:list={[
              "rounded-xl border border-line bg-surface p-6",
              i === 0 ? "md:col-span-2" : "",
            ]}
          >
            <h2 class="text-lg font-bold">{q.title[lang]}</h2>
            <p class="mt-2 max-w-[62ch] text-sm leading-relaxed text-muted">{q.body[lang]}</p>
            <p class="mt-4 text-sm font-semibold text-accent">
              <span class="font-medium text-muted">{dict.experience.rewardLabel}: </span>
              {q.reward[lang]}
            </p>
          </article>
        ))
      }
    </div>
  </main>
  <Footer lang={lang} />
</Base>
